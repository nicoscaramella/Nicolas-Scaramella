# Copiar a .env y ajustar si hace falta.
SISTEMA_NOMBRE=Nicolas-Scaramella
MQTT_HOST=broker
MQTT_PORT=1883
PLANTA_URL=http://sim:8100
DATABASE_URL=postgresql://sistema:sistema@postgres:5432/sistema
HTTP_PROXY=http://enlace:3128
HTTPS_PROXY=http://enlace:3128
NO_PROXY=broker,sim,localhost,postgres,agente,host.docker.internal,127.0.0.1
ASR_MODEL=small
ASR_COMPUTE=int8
ASR_CPU_THREADS=2
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Latido cada 30 s, como pide el contrato.
HEARTBEAT_S=30
MAX_INTENTOS=3
TIMEOUT_NOTA_S=120
MAX_PASOS=8
PRESUPUESTO_TOKENS=0
RAG_AUTOINDEX=1
RAG_AUTOINDEX_DELAY_S=60
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2

# LLM local opcional (Ollama). Ver README > "LLM local opcional".
# En planta-lan (internal:true) el host se alcanza por el gateway de la red.
LLM_HABILITADO=0
LLM_MODEL=ministral-3:3b
# Allowlist: solo estos modelos se pueden llamar, aunque Ollama tenga otros.
LLM_MODELOS_PERMITIDOS=ministral-3:3b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=200
